import datetime
import os
from abc import ABC, abstractmethod


# =========================================================================
# 1. CONFIGURACIÓN DE CARPETAS Y ARCHIVOS DEL SISTEMA
# =========================================================================

CARPETA_LOGS = "logs"
CARPETA_EXPORTACIONES = "exportaciones"

ARCHIVO_LOG = os.path.join(CARPETA_LOGS, "log_sistema.txt")
ARCHIVO_RESERVAS = os.path.join(CARPETA_EXPORTACIONES, "reservas_exportadas.txt")


def crear_carpetas_sistema():
    """
    Crea automáticamente las carpetas necesarias del sistema.
    Si las carpetas ya existen, no genera error.
    """
    os.makedirs(CARPETA_LOGS, exist_ok=True)
    os.makedirs(CARPETA_EXPORTACIONES, exist_ok=True)


def registrar_log(mensaje):
    """
    Registra eventos y errores del sistema en el archivo logs/log_sistema.txt.
    El archivo se crea automáticamente si no existe.
    """
    try:
        crear_carpetas_sistema()

        ahora = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")

        with open(ARCHIVO_LOG, "a", encoding="utf-8") as archivo:
            archivo.write(f"[{ahora}] {mensaje}\n")

    except Exception as error:
        print(f"Error crítico al escribir en el log: {error}")


# =========================================================================
# 2. EXCEPCIONES PERSONALIZADAS
# =========================================================================

class ErrorSoftwareFJ(Exception):
    """Clase base para todas las excepciones del sistema."""
    pass


class ReservaInvalidaError(ErrorSoftwareFJ):
    """Excepción para errores en la creación o manipulación de reservas."""
    pass


class DatosClienteError(ErrorSoftwareFJ):
    """Excepción para errores en la validación del cliente."""
    pass


class ServicioNoDisponibleError(ErrorSoftwareFJ):
    """Excepción para intentos de usar un servicio no disponible."""
    pass


class ServicioInvalidoError(ErrorSoftwareFJ):
    """Excepción para errores en la creación de servicios."""
    pass


# =========================================================================
# 3. CLASE ABSTRACTA GENERAL
# =========================================================================

class Entidad(ABC):
    """
    Clase abstracta que representa una entidad general del sistema.
    Aplica el principio de abstracción.
    """

    def __init__(self, id_entidad):
        self._id_entidad = id_entidad

    @abstractmethod
    def mostrar_info(self):
        pass


# =========================================================================
# 4. CLASE CLIENTE
# =========================================================================

class Cliente(Entidad):
    """
    Clase que representa un cliente del sistema.
    Aplica encapsulación mediante atributos privados.
    """

    def __init__(self, id_cliente, nombre, correo):
        super().__init__(id_cliente)

        if not nombre or not nombre.strip():
            raise DatosClienteError("El nombre del cliente no puede estar vacío.")

        if "@" not in correo or "." not in correo:
            raise DatosClienteError(f"Formato de correo inválido: {correo}")

        self.__nombre = nombre.strip()
        self.__correo = correo.strip()

    @property
    def nombre(self):
        return self.__nombre

    @property
    def correo(self):
        return self.__correo

    def mostrar_info(self):
        return f"Cliente: {self.__nombre} | ID: {self._id_entidad} | Correo: {self.__correo}"


# =========================================================================
# 5. CLASE ABSTRACTA SERVICIO
# =========================================================================

class Servicio(ABC):
    """
    Clase abstracta que define la estructura general de los servicios.
    """

    def __init__(self, nombre_servicio, precio_base, disponible=True):
        if not nombre_servicio or not nombre_servicio.strip():
            raise ServicioInvalidoError("El nombre del servicio no puede estar vacío.")

        if precio_base <= 0:
            raise ServicioInvalidoError("El precio base del servicio debe ser mayor que cero.")

        self.nombre_servicio = nombre_servicio.strip()
        self.precio_base = precio_base
        self.disponible = disponible

    def cambiar_disponibilidad(self, estado):
        self.disponible = estado

    @abstractmethod
    def calcular_costo(self, *args, **kwargs):
        pass

    @abstractmethod
    def descripcion(self):
        pass


# =========================================================================
# 6. SERVICIOS ESPECIALIZADOS
# =========================================================================

class ReservaSala(Servicio):
    """
    Servicio de reserva de sala.
    Calcula el costo por horas, aplicando impuesto opcional.
    """

    def calcular_costo(self, horas, impuesto=0.19):
        if horas <= 0:
            raise ValueError("Las horas deben ser mayores que cero.")

        return round((self.precio_base * horas) * (1 + impuesto), 2)

    def descripcion(self):
        return f"Reserva de sala: ${self.precio_base:.2f} por hora."


class AlquilerEquipo(Servicio):
    """
    Servicio de alquiler de equipos.
    Calcula el costo por días, con descuento opcional.
    """

    def calcular_costo(self, dias, descuento=0):
        if dias <= 0:
            raise ValueError("Los días deben ser mayores que cero.")

        costo = (self.precio_base * dias) - descuento
        return round(max(0, costo), 2)

    def descripcion(self):
        return f"Alquiler de equipo: ${self.precio_base:.2f} por día."


class AsesoriaEspecializada(Servicio):
    """
    Servicio de asesoría especializada.
    Calcula el costo por sesiones.
    """

    def calcular_costo(self, sesiones):
        if sesiones <= 0:
            raise ValueError("Las sesiones deben ser mayores que cero.")

        return round(self.precio_base * sesiones, 2)

    def descripcion(self):
        return f"Asesoría especializada: ${self.precio_base:.2f} por sesión."


# =========================================================================
# 7. CLASE RESERVA
# =========================================================================

class Reserva:
    """
    Clase que relaciona un cliente con un servicio y una duración.
    Permite procesar, confirmar y cancelar reservas.
    """

    ESTADOS_VALIDOS = {
        "Pendiente",
        "Confirmada",
        "Cancelada",
        "Fallida",
        "Error de Sistema"
    }

    def __init__(self, cliente, servicio, duracion):
        self.cliente = cliente
        self.servicio = servicio
        self.duracion = duracion
        self.estado = "Pendiente"
        self.costo_final = 0

    def procesar_reserva(self):
        """
        Procesa la reserva con manejo avanzado de excepciones.
        Usa try/except/else/finally y encadenamiento de excepciones.
        """
        try:
            if not self.cliente:
                raise ValueError("La reserva requiere un cliente registrado.")

            if not self.servicio:
                raise ValueError("La reserva requiere un servicio definido.")

            if not self.servicio.disponible:
                raise ServicioNoDisponibleError("El servicio no se encuentra disponible.")

            if self.duracion <= 0:
                raise ValueError("La duración debe ser mayor que cero.")

            self.costo_final = self.servicio.calcular_costo(self.duracion)

        except ValueError as error:
            self.estado = "Fallida"
            mensaje_error = f"Parámetro inválido en reserva: {error}"
            registrar_log(f"RESERVA RECHAZADA: {mensaje_error}")

            raise ReservaInvalidaError(mensaje_error) from error

        except ServicioNoDisponibleError as error:
            self.estado = "Fallida"
            registrar_log(f"SERVICIO NO DISPONIBLE: {error}")
            raise

        except Exception as error:
            self.estado = "Error de Sistema"
            registrar_log(f"ERROR NO CONTROLADO: {type(error).__name__}: {error}")
            print(f"Error inesperado: {type(error).__name__}: {error}")

        else:
            self.estado = "Confirmada"
            mensaje_exito = (
                f"ÉXITO: {self.servicio.nombre_servicio} para {self.cliente.nombre} "
                f"- Total: ${self.costo_final:.2f}"
            )
            registrar_log(mensaje_exito)
            print(mensaje_exito)

        finally:
            print(f"Finalización de proceso: {self.estado}\n")

    def confirmar(self):
        if self.estado != "Pendiente":
            raise ReservaInvalidaError(
                f"No se puede confirmar una reserva en estado '{self.estado}'."
            )

        self.estado = "Confirmada"
        registrar_log(f"CONFIRMACIÓN MANUAL: Reserva confirmada para {self.cliente.nombre}.")

    def cancelar(self):
        if self.estado == "Confirmada":
            self.estado = "Cancelada"
            registrar_log(f"CANCELACIÓN: Reserva cancelada para {self.cliente.nombre}.")
        else:
            raise ReservaInvalidaError(
                f"No se puede cancelar una reserva en estado '{self.estado}'."
            )


# =========================================================================
# 8. GESTOR CENTRAL DEL SISTEMA
# =========================================================================

class GestorSoftwareFJ:
    """
    Clase central que gestiona clientes, servicios y reservas.
    Usa listas internas y no utiliza base de datos.
    """

    def __init__(self):
        self.lista_clientes = []
        self.lista_servicios = []
        self.lista_reservas = []

    def agregar_cliente(self, cliente):
        if cliente not in self.lista_clientes:
            self.lista_clientes.append(cliente)

        registrar_log(f"CLIENTE AGREGADO: {cliente.mostrar_info()}")

    def agregar_servicio(self, servicio):
        if servicio not in self.lista_servicios:
            self.lista_servicios.append(servicio)

        registrar_log(f"SERVICIO AGREGADO: {servicio.nombre_servicio}")

    def registrar_reserva(self, cliente, servicio, duracion):
        if cliente not in self.lista_clientes:
            raise DatosClienteError("Cliente no registrado en el sistema.")

        if servicio not in self.lista_servicios:
            raise ServicioNoDisponibleError("Servicio no registrado en el sistema.")

        reserva = Reserva(cliente, servicio, duracion)
        self.lista_reservas.append(reserva)

        registrar_log(
            f"RESERVA REGISTRADA: {servicio.nombre_servicio} para {cliente.nombre} "
            f"duración {duracion}. Estado inicial: {reserva.estado}"
        )

        return reserva

    def listar_reservas(self):
        print("\n" + "=" * 70)
        print("=== LISTADO DE RESERVAS ===".center(70))
        print("=" * 70)

        if not self.lista_reservas:
            print("No hay reservas registradas.".center(70))
        else:
            print(f"{'N°':<4} {'SERVICIO':<22} {'CLIENTE':<20} {'DURACIÓN':<10} {'ESTADO':<12}")
            print("-" * 70)

            for indice, reserva in enumerate(self.lista_reservas, 1):
                servicio = reserva.servicio.nombre_servicio
                cliente = reserva.cliente.nombre

                print(
                    f"{indice:<4} "
                    f"{servicio:<22} "
                    f"{cliente:<20} "
                    f"{reserva.duracion:<10} "
                    f"{reserva.estado:<12}"
                )

        print("=" * 70 + "\n")

    def exportar_reservas_txt(self, archivo=ARCHIVO_RESERVAS):
        """
        Exporta automáticamente el listado de reservas a:
        exportaciones/reservas_exportadas.txt
        """
        try:
            crear_carpetas_sistema()

            with open(archivo, "w", encoding="utf-8") as f:
                f.write("=" * 70 + "\n")
                f.write("=== LISTADO DE RESERVAS ===\n")
                f.write("=" * 70 + "\n\n")

                if not self.lista_reservas:
                    f.write("No hay reservas registradas.\n")
                else:
                    f.write(
                        f"{'N°':<4} "
                        f"{'SERVICIO':<22} "
                        f"{'CLIENTE':<20} "
                        f"{'DURACIÓN':<10} "
                        f"{'ESTADO':<12} "
                        f"{'COSTO':<12}\n"
                    )
                    f.write("-" * 90 + "\n")

                    for indice, reserva in enumerate(self.lista_reservas, 1):
                        servicio = reserva.servicio.nombre_servicio
                        cliente = reserva.cliente.nombre

                        f.write(
                            f"{indice:<4} "
                            f"{servicio:<22} "
                            f"{cliente:<20} "
                            f"{reserva.duracion:<10} "
                            f"{reserva.estado:<12} "
                            f"${reserva.costo_final:<12.2f}\n"
                        )

                    f.write("-" * 90 + "\n\n")

                    total_confirmadas = sum(
                        1 for reserva in self.lista_reservas
                        if reserva.estado == "Confirmada"
                    )

                    total_canceladas = sum(
                        1 for reserva in self.lista_reservas
                        if reserva.estado == "Cancelada"
                    )

                    total_fallidas = sum(
                        1 for reserva in self.lista_reservas
                        if reserva.estado in {"Fallida", "Error de Sistema"}
                    )

                    f.write(f"Total reservas confirmadas: {total_confirmadas}\n")
                    f.write(f"Total reservas canceladas: {total_canceladas}\n")
                    f.write(f"Total reservas fallidas: {total_fallidas}\n")
                    f.write(f"Total reservas registradas: {len(self.lista_reservas)}\n")

            registrar_log(f"LISTADO EXPORTADO: Reservas exportadas a {archivo}")
            print(f"Reservas exportadas automáticamente en: {archivo}")

        except Exception as error:
            registrar_log(f"ERROR EXPORTANDO RESERVAS: {error}")
            print(f"Error al exportar reservas: {error}")


# =========================================================================
# 9. SIMULACIÓN AUTOMÁTICA DE OPERACIONES
# =========================================================================

def ejecutar_simulacion_automatica():
    crear_carpetas_sistema()

    print("=========================================================")
    print("--- SISTEMA INTEGRAL SOFTWARE FJ ---")
    print("Simulación de operaciones válidas e inválidas")
    print("=========================================================\n")

    registrar_log("INICIO DE EJECUCIÓN DEL SISTEMA SOFTWARE FJ")

    gestor = GestorSoftwareFJ()

    # Crear servicios
    s_sala = ReservaSala("Reserva de Sala", 60000)
    s_equipo = AlquilerEquipo("Alquiler de Laptop", 45000)
    s_asesoria = AsesoriaEspecializada("Asesoría IT", 120000)

    gestor.agregar_servicio(s_sala)
    gestor.agregar_servicio(s_equipo)
    gestor.agregar_servicio(s_asesoria)

    # Crear clientes
    clientes = []

    try:
        clientes.append(Cliente("C01", "Juan David", "juan@unad.edu.co"))
        clientes.append(Cliente("C02", "Maria Lopez", "maria@unad.edu.co"))

        # Cliente inválido
        clientes.append(Cliente("C03", "Pedro Error", "pedro_sin_arroba.com"))

    except DatosClienteError as error:
        registrar_log(f"FALLO REGISTRO CLIENTE: {error}")
        print(f"Aviso de validación: {error}\n")
        clientes.append(None)

    # Registrar clientes válidos
    for cliente in clientes:
        if cliente is not None:
            gestor.agregar_cliente(cliente)

    operaciones = [
        (clientes[0], s_sala, 4, "Juan David"),
        (clientes[1], s_equipo, 2, "Maria Lopez"),
        (clientes[0], s_sala, -2, "Juan David"),
        (clientes[1], s_asesoria, 5, "Maria Lopez"),
        (clientes[2], s_equipo, 1, "Pedro Error"),
        (clientes[0], s_equipo, 3, "Juan David"),
        (clientes[1], s_sala, 2, "Maria Lopez"),
        (clientes[0], s_asesoria, 0, "Juan David"),
        (clientes[1], s_equipo, 1, "Maria Lopez"),
        (clientes[0], s_sala, 5, "Juan David")
    ]

    for indice, (cliente, servicio, duracion, nombre_cliente) in enumerate(operaciones, 1):
        print(f"Operación #{indice}:")

        try:
            reserva = gestor.registrar_reserva(cliente, servicio, duracion)
            reserva.procesar_reserva()

        except ReservaInvalidaError as error:
            print(f"Resultado: {error}\n")
            registrar_log(f"OPERACIÓN #{indice} FALLIDA: {error}")

        except DatosClienteError as error:
            print(f"Resultado: Cliente '{nombre_cliente}' no registrado - {error}\n")
            registrar_log(f"OPERACIÓN #{indice} FALLIDA POR CLIENTE: {error}")

        except ServicioNoDisponibleError as error:
            print(f"Resultado: Servicio no disponible - {error}\n")
            registrar_log(f"OPERACIÓN #{indice} FALLIDA POR SERVICIO: {error}")

        except ErrorSoftwareFJ as error:
            print(f"Error del sistema: {error}\n")
            registrar_log(f"OPERACIÓN #{indice} FALLIDA: {error}")

        except Exception as error:
            print(f"Error inesperado: {error}\n")
            registrar_log(f"ERROR INESPERADO EN OPERACIÓN #{indice}: {error}")

    gestor.listar_reservas()

    # Exportación automática por defecto
    gestor.exportar_reservas_txt()

    registrar_log("FIN DE EJECUCIÓN DEL SISTEMA SOFTWARE FJ")


if __name__ == "__main__":
    ejecutar_simulacion_automatica()
