from abc import ABC, abstractmethod
import os
import datetime
import re


# ============================================================
# CONFIGURACIÓN DE CARPETAS Y ARCHIVOS DEL SISTEMA
# ============================================================

CARPETA_LOGS = "logs"
CARPETA_EXPORTACIONES = "exportaciones"

ARCHIVO_LOG = os.path.join(CARPETA_LOGS, "log_sistema.txt")
ARCHIVO_EXPORTACION = os.path.join(CARPETA_EXPORTACIONES, "reservas_exportadas.txt")


def crear_carpetas_sistema():
    """
    Crea las carpetas necesarias para guardar logs y exportaciones.
    Si las carpetas ya existen, no genera error.
    """
    os.makedirs(CARPETA_LOGS, exist_ok=True)
    os.makedirs(CARPETA_EXPORTACIONES, exist_ok=True)


def registrar_evento(mensaje):
    """
    Registra eventos importantes del sistema en logs/log_sistema.txt.
    """
    crear_carpetas_sistema()

    fecha_actual = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")

    with open(ARCHIVO_LOG, "a", encoding="utf-8") as archivo:
        archivo.write(f"[{fecha_actual}] EVENTO: {mensaje}\n")


def registrar_error(mensaje):
    """
    Registra errores controlados o inesperados en logs/log_sistema.txt.
    """
    crear_carpetas_sistema()

    fecha_actual = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")

    with open(ARCHIVO_LOG, "a", encoding="utf-8") as archivo:
        archivo.write(f"[{fecha_actual}] ERROR: {mensaje}\n")


# ============================================================
# EXCEPCIONES PERSONALIZADAS
# ============================================================

class ErrorSistema(Exception):
    """Excepción base para todos los errores del sistema."""
    pass


class ClienteInvalidoError(ErrorSistema):
    """Error relacionado con datos inválidos del cliente."""
    pass


class ServicioInvalidoError(ErrorSistema):
    """Error relacionado con datos inválidos del servicio."""
    pass


class ServicioNoDisponibleError(ErrorSistema):
    """Error cuando un servicio no está disponible."""
    pass


class ReservaInvalidaError(ErrorSistema):
    """Error cuando una reserva tiene datos inválidos."""
    pass


class OperacionNoPermitidaError(ErrorSistema):
    """Error cuando se intenta realizar una operación no permitida."""
    pass


# ============================================================
# CLASE ABSTRACTA GENERAL
# ============================================================

class EntidadSistema(ABC):
    """
    Clase abstracta general del sistema.
    Sirve como base para entidades principales como Cliente.
    """

    def __init__(self, identificador):
        self._identificador = identificador

    @property
    def identificador(self):
        return self._identificador

    @abstractmethod
    def mostrar_informacion(self):
        pass


# ============================================================
# CLASE CLIENTE
# ============================================================

class Cliente(EntidadSistema):
    """
    Representa un cliente de Software FJ.
    Aplica encapsulación mediante atributos privados.
    """

    def __init__(self, identificador, nombre, documento, correo, telefono):
        super().__init__(identificador)
        self.__nombre = self.__validar_nombre(nombre)
        self.__documento = self.__validar_documento(documento)
        self.__correo = self.__validar_correo(correo)
        self.__telefono = self.__validar_telefono(telefono)

    def __validar_nombre(self, nombre):
        if not nombre or not nombre.strip():
            raise ClienteInvalidoError("El nombre del cliente no puede estar vacío.")
        return nombre.strip()

    def __validar_documento(self, documento):
        try:
            documento_numero = int(documento)
        except ValueError as error:
            raise ClienteInvalidoError("El documento debe contener solo números.") from error

        if documento_numero <= 0:
            raise ClienteInvalidoError("El documento debe ser un número positivo.")

        return str(documento_numero)

    def __validar_correo(self, correo):
        patron = r"^[\w\.-]+@[\w\.-]+\.\w+$"

        if not correo or not re.match(patron, correo):
            raise ClienteInvalidoError("El correo electrónico no tiene un formato válido.")

        return correo.strip()

    def __validar_telefono(self, telefono):
        if not telefono or not telefono.isdigit() or len(telefono) < 7:
            raise ClienteInvalidoError("El teléfono debe tener mínimo 7 dígitos numéricos.")
        return telefono

    @property
    def nombre(self):
        return self.__nombre

    @property
    def documento(self):
        return self.__documento

    @property
    def correo(self):
        return self.__correo

    @property
    def telefono(self):
        return self.__telefono

    def mostrar_informacion(self):
        return (
            f"Cliente: {self.__nombre} | "
            f"Documento: {self.__documento} | "
            f"Correo: {self.__correo} | "
            f"Teléfono: {self.__telefono}"
        )


# ============================================================
# CLASE ABSTRACTA SERVICIO
# ============================================================

class Servicio(ABC):
    """
    Clase abstracta que define la estructura común de todos los servicios.
    """

    def __init__(self, nombre, precio_base, disponible=True):
        self._nombre = self.__validar_nombre(nombre)
        self._precio_base = self.__validar_precio(precio_base)
        self._disponible = disponible

    def __validar_nombre(self, nombre):
        if not nombre or not nombre.strip():
            raise ServicioInvalidoError("El nombre del servicio no puede estar vacío.")
        return nombre.strip()

    def __validar_precio(self, precio_base):
        if precio_base <= 0:
            raise ServicioInvalidoError("El precio base debe ser mayor que cero.")
        return precio_base

    @property
    def nombre(self):
        return self._nombre

    @property
    def precio_base(self):
        return self._precio_base

    @property
    def disponible(self):
        return self._disponible

    def cambiar_disponibilidad(self, estado):
        self._disponible = estado

    @abstractmethod
    def calcular_costo(self, duracion, descuento=0, impuesto=0):
        pass

    @abstractmethod
    def describir_servicio(self):
        pass

    @abstractmethod
    def validar_parametros(self, duracion):
        pass


# ============================================================
# SERVICIO 1: RESERVA DE SALA
# ============================================================

class ReservaSala(Servicio):
    """
    Servicio especializado para reserva de salas.
    """

    def __init__(self, nombre, precio_base, capacidad, ubicacion, disponible=True):
        super().__init__(nombre, precio_base, disponible)

        if capacidad <= 0:
            raise ServicioInvalidoError("La capacidad de la sala debe ser mayor que cero.")

        self.capacidad = capacidad
        self.ubicacion = ubicacion

    def validar_parametros(self, duracion):
        if duracion <= 0:
            raise ServicioInvalidoError("La duración de la reserva de sala debe ser mayor que cero.")

    def calcular_costo(self, duracion, descuento=0, impuesto=0):
        self.validar_parametros(duracion)

        costo = self.precio_base * duracion
        costo -= costo * descuento
        costo += costo * impuesto

        return round(costo, 2)

    def describir_servicio(self):
        return f"Reserva de sala en {self.ubicacion}, capacidad para {self.capacidad} personas."


# ============================================================
# SERVICIO 2: ALQUILER DE EQUIPO
# ============================================================

class AlquilerEquipo(Servicio):
    """
    Servicio especializado para alquiler de equipos.
    """

    def __init__(self, nombre, precio_base, tipo_equipo, cantidad, disponible=True):
        super().__init__(nombre, precio_base, disponible)

        if cantidad <= 0:
            raise ServicioInvalidoError("La cantidad de equipos debe ser mayor que cero.")

        self.tipo_equipo = tipo_equipo
        self.cantidad = cantidad

    def validar_parametros(self, duracion):
        if duracion <= 0:
            raise ServicioInvalidoError("La duración del alquiler debe ser mayor que cero.")

    def calcular_costo(self, duracion, descuento=0, impuesto=0):
        self.validar_parametros(duracion)

        costo = self.precio_base * duracion * self.cantidad
        costo -= costo * descuento
        costo += costo * impuesto

        return round(costo, 2)

    def describir_servicio(self):
        return f"Alquiler de {self.cantidad} equipo(s) tipo {self.tipo_equipo}."


# ============================================================
# SERVICIO 3: ASESORÍA ESPECIALIZADA
# ============================================================

class AsesoriaEspecializada(Servicio):
    """
    Servicio especializado para asesorías.
    """

    def __init__(self, nombre, precio_base, area, nivel, disponible=True):
        super().__init__(nombre, precio_base, disponible)

        niveles_validos = ["basico", "intermedio", "avanzado"]

        if nivel not in niveles_validos:
            raise ServicioInvalidoError("El nivel debe ser basico, intermedio o avanzado.")

        self.area = area
        self.nivel = nivel

    def validar_parametros(self, duracion):
        if duracion <= 0:
            raise ServicioInvalidoError("La duración de la asesoría debe ser mayor que cero.")

    def calcular_costo(self, duracion, descuento=0, impuesto=0):
        self.validar_parametros(duracion)

        factor = 1

        if self.nivel == "intermedio":
            factor = 1.5
        elif self.nivel == "avanzado":
            factor = 2

        costo = self.precio_base * duracion * factor
        costo -= costo * descuento
        costo += costo * impuesto

        return round(costo, 2)

    def describir_servicio(self):
        return f"Asesoría especializada en {self.area}, nivel {self.nivel}."


# ============================================================
# CLASE RESERVA
# ============================================================

class Reserva:
    """
    Representa una reserva asociada a un cliente y a un servicio.
    """

    def __init__(self, cliente, servicio, duracion):
        if cliente is None:
            raise ReservaInvalidaError("La reserva debe tener un cliente asociado.")

        if servicio is None:
            raise ReservaInvalidaError("La reserva debe tener un servicio asociado.")

        if duracion <= 0:
            raise ReservaInvalidaError("La duración de la reserva debe ser mayor que cero.")

        self.cliente = cliente
        self.servicio = servicio
        self.duracion = duracion
        self.estado = "Pendiente"
        self.costo_total = 0

    def confirmar(self):
        if not self.servicio.disponible:
            raise ServicioNoDisponibleError(
                "No se puede confirmar la reserva porque el servicio no está disponible."
            )

        if self.estado != "Pendiente":
            raise OperacionNoPermitidaError(
                "Solo se pueden confirmar reservas en estado Pendiente."
            )

        self.estado = "Confirmada"
        registrar_evento(f"Reserva confirmada para el cliente {self.cliente.nombre}")

    def cancelar(self):
        if self.estado == "Procesada":
            raise OperacionNoPermitidaError(
                "No se puede cancelar una reserva ya procesada."
            )

        self.estado = "Cancelada"
        registrar_evento(f"Reserva cancelada para el cliente {self.cliente.nombre}")

    def procesar(self, descuento=0, impuesto=0):
        if self.estado != "Confirmada":
            raise OperacionNoPermitidaError(
                "Solo se pueden procesar reservas confirmadas."
            )

        self.costo_total = self.servicio.calcular_costo(
            self.duracion,
            descuento=descuento,
            impuesto=impuesto
        )

        self.estado = "Procesada"
        registrar_evento(f"Reserva procesada para el cliente {self.cliente.nombre}")

        return self.costo_total

    def mostrar_resumen(self):
        return (
            f"Cliente: {self.cliente.nombre} | "
            f"Servicio: {self.servicio.nombre} | "
            f"Duración: {self.duracion} | "
            f"Estado: {self.estado} | "
            f"Costo total: {self.costo_total}"
        )


# ============================================================
# CLASE SISTEMA DE GESTIÓN
# ============================================================

class SistemaGestion:
    """
    Clase central que administra clientes, servicios y reservas.
    Usa listas internas, sin bases de datos.
    """

    def __init__(self):
        self.clientes = []
        self.servicios = []
        self.reservas = []

    def registrar_cliente(self, cliente):
        if not isinstance(cliente, Cliente):
            raise ClienteInvalidoError("Solo se pueden registrar objetos de tipo Cliente.")

        self.clientes.append(cliente)
        registrar_evento(f"Cliente registrado: {cliente.nombre}")
        return cliente

    def registrar_servicio(self, servicio):
        if not isinstance(servicio, Servicio):
            raise ServicioInvalidoError("Solo se pueden registrar objetos derivados de Servicio.")

        self.servicios.append(servicio)
        registrar_evento(f"Servicio registrado: {servicio.nombre}")
        return servicio

    def crear_reserva(self, cliente, servicio, duracion):
        reserva = Reserva(cliente, servicio, duracion)
        self.reservas.append(reserva)

        registrar_evento(f"Reserva creada para el cliente {cliente.nombre}")

        return reserva

    def listar_clientes(self):
        return [cliente.mostrar_informacion() for cliente in self.clientes]

    def listar_servicios(self):
        return [servicio.describir_servicio() for servicio in self.servicios]

    def listar_reservas(self):
        return [reserva.mostrar_resumen() for reserva in self.reservas]

    def exportar_reservas(self):
        """
        Exporta el listado de reservas a exportaciones/reservas_exportadas.txt.
        """
        crear_carpetas_sistema()

        with open(ARCHIVO_EXPORTACION, "w", encoding="utf-8") as archivo:
            archivo.write("============================================================\n")
            archivo.write("              RESERVAS EXPORTADAS - SOFTWARE FJ\n")
            archivo.write("============================================================\n\n")

            if not self.reservas:
                archivo.write("No existen reservas registradas.\n")
            else:
                for indice, reserva in enumerate(self.reservas, start=1):
                    archivo.write(f"Reserva #{indice}\n")
                    archivo.write(f"Cliente: {reserva.cliente.nombre}\n")
                    archivo.write(f"Servicio: {reserva.servicio.nombre}\n")
                    archivo.write(f"Duración: {reserva.duracion}\n")
                    archivo.write(f"Estado: {reserva.estado}\n")
                    archivo.write(f"Costo total: {reserva.costo_total}\n")
                    archivo.write("-" * 60 + "\n")

            archivo.write("\nFin del reporte de reservas.\n")

        registrar_evento(f"Reservas exportadas correctamente en {ARCHIVO_EXPORTACION}")


# ============================================================
# FUNCIÓN PARA EJECUTAR OPERACIONES DE PRUEBA
# ============================================================

def ejecutar_operacion(numero, descripcion, funcion):
    """
    Ejecuta cada operación con manejo de excepciones.
    Si una operación falla, el sistema continúa funcionando.
    """

    print(f"\nOperación {numero}: {descripcion}")

    try:
        resultado = funcion()

    except ErrorSistema as error:
        print(f"Error controlado: {error}")
        registrar_error(f"Operación {numero} fallida: {error}")

    except Exception as error:
        print(f"Error inesperado: {error}")
        registrar_error(f"Operación {numero} generó un error inesperado: {error}")

    else:
        print("Operación ejecutada correctamente.")

        if resultado is not None:
            print(resultado)

        registrar_evento(f"Operación {numero} ejecutada correctamente: {descripcion}")

    finally:
        print("Finalizó la operación.")


